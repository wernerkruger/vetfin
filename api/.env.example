# Copy to .env or .env.local (both gitignored). Plaid sandbox keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

PORT=3001
HOST=0.0.0.0

# Comma-separated origins allowed for CORS (must include your public web URL in production)
CORS_ORIGINS=http://localhost:5173

# SQLite database file (created automatically). In Docker: /data/vetfin.sqlite on a volume.
DATABASE_PATH=./data/vetfin.sqlite

# Encrypt Plaid access tokens & account numbers at rest (min 16 chars). Required when NODE_ENV=production.
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Practice & borrower JWT (min 32 chars). Required in production — do not use the default below.
# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-vetfin-jwt-secret-32chars

# Public URL of the web app (used for referral links and QR codes). Must match how users reach the site.
PUBLIC_APP_URL=http://localhost:5173

# Admin console at /admin — store only the bcrypt hash, never the plain password in git.
# Generate: cd api && node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(console.log)"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
