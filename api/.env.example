# Copy to .env or .env.local (both gitignored).
# LOCAL DEVELOPMENT — referral links/QR codes use localhost.
# For AWS, use deploy/aws/.env.production.example on the server instead (APP_ENV=production).

APP_ENV=development

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

PORT=3001
HOST=0.0.0.0

# Must be localhost for local Vite (http://localhost:5173).
# Local docker compose: use http://localhost (nginx on :80).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file (created automatically). In Docker: /data/vetfin.sqlite on a volume.
DATABASE_PATH=./data/vetfin.sqlite

# Encrypt Plaid access tokens & account numbers at rest (min 16 chars). Required when NODE_ENV=production.
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Practice & borrower JWT (min 32 chars). Required in production — do not use the default below.
# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-vetfin-jwt-secret-32chars

# Public URL of the web app (referral links and QR codes).
PUBLIC_APP_URL=http://localhost:5173

# Admin console at /admin — store only a hash, never the plain password in git.
# Docker Compose mangles $ in .env values; use base64 (recommended for EC2/Docker):
#   docker compose ... exec api node -e "require('bcryptjs').hash('YOUR_PASSWORD',12).then(h=>console.log(Buffer.from(h).toString('base64')))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=
# Or raw bcrypt (local dev only): ADMIN_PASSWORD_HASH=
