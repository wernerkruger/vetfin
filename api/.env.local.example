# Optional local overrides (gitignored). Loaded after .env and wins on conflicts.
# Use this so a shared/copied .env with AWS hosts cannot break local referral links.
#
#   cp .env.local.example .env.local

APP_ENV=development
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
