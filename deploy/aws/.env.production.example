# Copy to api/.env on your EC2 instance (see deploy/aws/README.md).
# Do NOT use this file for local npm run / Vite — use api/.env.example instead.

APP_ENV=production

# --- Required ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

JWT_SECRET=CHANGE_ME_min_32_characters_random_string
DATA_ENCRYPTION_KEY=CHANGE_ME_min_16_characters

# --- Database (Postgres container from docker-compose.yml) ---
# Set before the first deploy: the password is baked into the database volume on first start.
# Generate: openssl rand -hex 24
DB_NAME=vetfin
DB_USER=vetfin
DB_PASSWORD=CHANGE_ME_strong_password

# --- Public URL (must match how users open the site) ---
# HTTP + Elastic IP:
#   PUBLIC_APP_URL=http://1.2.3.4
#   CORS_ORIGINS=http://1.2.3.4
# HTTPS + domain (also set DOMAIN for ./deploy/aws/deploy.sh https):
#   DOMAIN=app.example.com
#   PUBLIC_APP_URL=https://app.example.com
#   CORS_ORIGINS=https://app.example.com

PUBLIC_APP_URL=http://YOUR_ELASTIC_IP
CORS_ORIGINS=http://YOUR_ELASTIC_IP
# DOMAIN=app.example.com

# Lender ("creditor") named on the Truth in Lending disclosure — your partner bank once signed.
# LENDER_NAME=Example Bank, N.A.
# LENDER_ADDRESS=1 Main St, Columbus, OH 43215

# Admin console (/admin) — use base64 hash in Docker (Compose mangles $ in raw bcrypt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH_B64=
